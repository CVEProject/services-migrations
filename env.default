# Copy this file to .env, then update the values for your MongoDB instance.
NODE_ENV=development
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=your_database_name

# Set these if your MongoDB instance requires authentication.
# MONGO_USER=your_username
# MONGO_PASSWORD=your_password

# Alternatively, provide a full connection string instead of the host settings.
# MONGO_CONN_STRING=mongodb://localhost:27017/your_database_name
